{
  "manifest_version": 3,
  "name": "Rentway Reskin — CaribeCar",
  "short_name": "Rentway Reskin",
  "version": "2.1.0",
  "description": "Interface modernisée pour Rentway v1 et Rentway Pro (CaribeCar / Rent-A-Car Guadeloupe). Toutes les fonctions d'origine sont conservées.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Rentway Reskin",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://rentwayv1.emotionmobility.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://rentwayv1.emotionmobility.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://rentway.emotionmobility.com/*"
      ],
      "css": [
        "pro.css"
      ],
      "js": [
        "early.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://rentway.emotionmobility.com/*"
      ],
      "js": [
        "pro.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
